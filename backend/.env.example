# Django
DJANGO_SECRET_KEY=django-insecure-testkey
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# CORS
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# Database defaults to SQLite to preserve the current local behavior.
DB_ENGINE=sqlite
SQLITE_PATH=

# Optional PostgreSQL configuration.
# DB_ENGINE=postgres
# DATABASE_URL=postgresql://personal_shopper:personal_shopper@localhost:5432/personal_shopper
# POSTGRES_DB=personal_shopper
# POSTGRES_USER=personal_shopper
# POSTGRES_PASSWORD=personal_shopper
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_CONNECT_TIMEOUT=10
# DB_CONN_MAX_AGE=60

# Channels defaults to in-memory to preserve the current local behavior.
CHANNEL_LAYER_BACKEND=inmemory

# Optional Redis configuration.
# CHANNEL_LAYER_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
